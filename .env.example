# ============================================================
# AuraBank — Environment Variables EXAMPLE
# Copy this file to .env and fill in real values
# ============================================================

# Frontend
VITE_API_URL=http://localhost:5000/api

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=aurabank

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT Secrets
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_LONG_RANDOM_REFRESH_SECRET_MIN_32_CHARS

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ML API
ML_API_URL=http://ai-service:5001

# Application
NODE_ENV=production
PORT=5000
FLASK_ENV=production
